module full_adder_2b(S,A,B);

	//ports
	input [3:0] A;
	input [3:0] B;
	output [4:0] S;
	wire  [2:0] w;
		
	//half-adder instance
	half_adder ha(
		.A(A[0]),
		.B(B[0]),
		.sum(S[0]),
		.carry(w[0])
		
		);
	
	
	//full-adder instance
	full_adder fa(
		.A(A[1]),
		.B(B[1]),
		.cin(w[0]),
		.sum(S[1]),
		.cout(w[1])
		
	);
	
	full_adder fa1(
		.A(A[2]),
		.B(B[2]),
		.cin(w[1]),
		.sum(S[2]),
		.cout(w[2])
		
	);
	
	full_adder fa2(
		.A(A[3]),
		.B(B[3]),
		.cin(w[2]),
		.sum(S[3]),
		.cout(S[4])
		
	);
	
endmodule 